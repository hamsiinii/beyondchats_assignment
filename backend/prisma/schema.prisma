generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id            String   @id @default(uuid())
  title         String
  content       String?
  url           String   @unique
  publishedDate DateTime
  isRewritten   Boolean  @default(false)
  originalId    String?
  references    String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([publishedDate])
  @@index([isRewritten])
}
